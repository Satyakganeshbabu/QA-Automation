<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.satyak</groupId>
  <artifactId>harvee-qa-assessment</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <selenium.version>4.29.0</selenium.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <systemPropertyVariables>
            <baseUrl>${baseUrl}</baseUrl>
            <standardUser>${standardUser}</standardUser>
            <lockedOutUser>${lockedOutUser}</lockedOutUser>
            <saucePassword>${saucePassword}</saucePassword>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>default-config</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties>
        <baseUrl>https://www.saucedemo.com/</baseUrl>
        <standardUser>standard_user</standardUser>
        <lockedOutUser>locked_out_user</lockedOutUser>
        <saucePassword>secret_sauce</saucePassword>
      </properties>
    </profile>
  </profiles>
</project>
